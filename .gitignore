# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# 测试缓存
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# 运行产物与媒体：runs/ 仅放开 generated_media 测试素材，其余出片/日志继续忽略
runs/*
!runs/generated_media/
runs/generated_media/*
!runs/generated_media/cases/
!runs/generated_media/README.md
!runs/generated_media/*.mp4
!runs/generated_media/*.mov
!runs/generated_media/*.png
!runs/generated_media/*.jpg
!runs/generated_media/cases/**/*.mp4
!runs/generated_media/cases/**/*.mov
!runs/generated_media/cases/**/*.png
!runs/generated_media/cases/**/*.jpg
!runs/generated_media/cases/**/*.jpeg
*.log
*.pid

# 环境与密钥（从 *.example 复制后填写，禁止提交）
.env
.env.*
configs/gemini.yaml
configs/gemini.local.yaml
configs/h3.yaml
configs/h3.local.yaml

# 内部基础设施文档（含内网代理地址，禁止上传）
