{"id": "s3_a1_01", "mode": "t2va", "trap": "A1", "intent": "一只橘猫在窗台晒太阳，禁止切镜，单镜头缓推，约5秒", "assert": {"shot_count_eq": 1}, "focus": "A1_no_cut"}
{"id": "s3_a1_02", "mode": "t2va", "trap": "A1", "intent": "海浪拍打礁石，一镜到底缓摇，不得切镜，约7秒", "assert": {"shot_count_eq": 1}, "focus": "A1_no_cut"}
{"id": "s3_a1_03", "mode": "t2va", "trap": "A1", "intent": "蒸汽从马克杯升起，单镜头微距，禁止分镜，约4秒", "assert": {"shot_count_eq": 1}, "focus": "A1_no_cut"}
