{"id": "s3_a5_02", "mode": "t2va", "trap": "A5", "intent": "厨师切菜→翻锅→装盘，顺序完整，约7秒", "assert": {"action_chain": ["切菜", "翻锅", "装盘"]}, "focus": "A5_action_chain"}
{"id": "s3_a5_03", "mode": "t2va", "trap": "A5", "intent": "舞者起跳→旋转→落地，不要跳步，约5秒", "assert": {"action_chain": ["起跳", "旋转", "落地"]}, "focus": "A5_action_chain"}
