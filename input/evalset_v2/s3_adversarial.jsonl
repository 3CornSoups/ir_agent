{"id": "s3_a6_01", "mode": "t2va", "trap": "A6", "intent": "开门→进屋→放包→坐下→打开笔记本，不要跳步，约10秒", "assert": {"action_chain": ["开门", "进屋", "放包", "坐下", "打开笔记本"]}, "focus": "A6_long_chain"}
{"id": "s3_a6_02", "mode": "t2va", "trap": "A6", "intent": "起床→洗漱→穿衣→出门→上车，完整五步，约12秒", "assert": {"action_chain": ["起床", "洗漱", "穿衣", "出门", "上车"]}, "focus": "A6_long_chain"}
{"id": "s3_a6_03", "mode": "t2va", "trap": "A6", "intent": "取杯→倒水→加茶→搅拌→品尝，不要省略，约9秒", "assert": {"action_chain": ["取杯", "倒水", "加茶", "搅拌", "品尝"]}, "focus": "A6_long_chain"}
{"id": "s3_a6_04", "mode": "t2va", "trap": "A6", "intent": "解锁→推门→亮灯→挂衣→坐下，顺序不可乱，约8秒", "assert": {"action_chain": ["解锁", "推门", "亮灯", "挂衣", "坐下"]}, "focus": "A6_long_chain"}
{"id": "s3_a7_01", "mode": "t2va", "trap": "A7", "intent": "她说：『你来了。剑等得够久了。』约5秒", "assert": {"dialogue_verbatim": ["你来了。剑等得够久了。"]}, "focus": "A7_dialogue_zh", "expected_dialogue": ["你来了。剑等得够久了。"]}
{"id": "s3_a7_02", "mode": "t2va", "trap": "A7", "intent": "老人低声：「再等一个春天。」雨还在下，约6秒", "assert": {"dialogue_verbatim": ["再等一个春天。"]}, "focus": "A7_dialogue_zh", "expected_dialogue": ["再等一个春天。"]}
{"id": "s3_a7_03", "mode": "t2va", "trap": "A7", "intent": "女孩喊道：『别走！钥匙还在桌上。』约4秒", "assert": {"dialogue_verbatim": ["别走！钥匙还在桌上。"]}, "focus": "A7_dialogue_zh", "expected_dialogue": ["别走！钥匙还在桌上。"]}
{"id": "s3_a7_04", "mode": "t2va", "trap": "A7", "intent": "旁白：『山风停了，灯火才亮。』约7秒", "assert": {"dialogue_verbatim": ["山风停了，灯火才亮。"]}, "focus": "A7_dialogue_zh", "expected_dialogue": ["山风停了，灯火才亮。"]}
{"id": "s3_a8_01", "mode": "t2va", "trap": "A8", "intent": "品牌片结尾必须出现中文口号「让每一步都算数」，约6秒", "assert": {"onscreen_verbatim": ["让每一步都算数"]}, "focus": "A8_slogan", "expected_onscreen": ["让每一步都算数"]}
{"id": "s3_a8_02", "mode": "t2va", "trap": "A8", "intent": "片尾花字口号「认真生活」，不要英文占位，约5秒", "assert": {"onscreen_verbatim": ["认真生活"]}, "focus": "A8_slogan", "expected_onscreen": ["认真生活"]}
{"id": "s3_a8_03", "mode": "t2va", "trap": "A8", "intent": "广告收束字幕「新鲜刚刚好」必须原样出现，约4秒", "assert": {"onscreen_verbatim": ["新鲜刚刚好"]}, "focus": "A8_slogan", "expected_onscreen": ["新鲜刚刚好"]}
{"id": "s3_a8_04", "mode": "t2va", "trap": "A8", "intent": "结尾标语「看见更大的世界」保留中文，约6秒", "assert": {"onscreen_verbatim": ["看见更大的世界"]}, "focus": "A8_slogan", "expected_onscreen": ["看见更大的世界"]}
